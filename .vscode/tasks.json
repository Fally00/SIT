{
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake -B build -DCMAKE_BUILD_TYPE=Debug",
            "group": "build",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "cmake --build build --config Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "dependsOn": "CMake: Configure"
        }
    ],
    "version": "2.0.0"
}